{
  "name": "wadi",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --filter frontend dev",
    "build": "pnpm --filter frontend build",
    "start": "node scripts/start.mjs",
    "lint": "pnpm --filter frontend lint",
    "test": "pnpm --filter frontend test && pnpm --filter frontend test:api",
    "test:next": "pnpm --filter frontend test:next",
    "package:server": "node scripts/package-server.mjs"
  }
}
