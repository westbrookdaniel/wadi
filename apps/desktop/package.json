{
  "name": "@wadi/desktop",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "prepare:assets": "node scripts/prepare.mjs",
    "build": "pnpm prepare:assets && vite build",
    "dev": "pnpm build && electron .",
    "package": "pnpm build && electron-builder --config electron-builder.config.cjs",
    "test": "node --test src/*.test.mjs",
    "test:vaapi": "node scripts/check-vaapi.mjs"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "electron": "^41.0.0",
    "electron-builder": "^26.0.12",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "vite": "^8.0.10",
    "@vitejs/plugin-react": "^6.0.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "build": {
    "appId": "com.wadi.desktop",
    "productName": "Wadi",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "!src/**/*.test.mjs",
      "dist/**/*",
      "desktop-config.json",
      "package.json",
      "resources/icon.png",
      "resources/icon-mac.png"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "media-bin"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.entertainment",
      "hardenedRuntime": true,
      "icon": "resources/icon-mac.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "maintainer": "Wadi contributors",
      "icon": "resources/icons",
      "executableName": "wadi",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "StartupWMClass": "wadi"
        }
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "Wadi-${version}-${os}-${arch}.${ext}",
    "deb": {
      "packageName": "wadi",
      "desktop": {
        "entry": {
          "StartupWMClass": "wadi",
          "Actions": "Fullscreen;"
        },
        "desktopActions": {
          "Fullscreen": {
            "Name": "Open Fullscreen",
            "Exec": "/opt/Wadi/wadi --fullscreen"
          }
        }
      }
    }
  },
  "description": "Wadi media browser and desktop player",
  "author": "Wadi contributors",
  "license": "MIT",
  "homepage": "https://watchwadi.com",
  "desktopName": "wadi.desktop"
}
