# Server-only. Set this in your shell too when running pnpm db:migrate.
DATABASE_URL=postgresql://user:password@host:5432/wadi
SESSION_TTL_DAYS=30
# Set after desktop installers are published.
NEXT_PUBLIC_DESKTOP_RELEASES_URL=
NEXT_PUBLIC_DESKTOP_DOWNLOAD_URL=

# Server-only verification email delivery. Verify the domain in Resend first.
RESEND_API_KEY=
EMAIL_FROM=Wadi <noreply@watchwadi.com>

# Canonical OAuth issuer and MCP resource origin (server-only).
WADI_PUBLIC_ORIGIN=https://watchwadi.com
